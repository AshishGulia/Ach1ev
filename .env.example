# ==============================================================================
# Achiev (Settle Ideas) — Environment Variables Template
# Primary Domain: https://achiev.com (Secondary: Vercel deployment URL)
# ==============================================================================

# 1. Gemini AI Backend API (Express & Vercel Serverless `/api/*`)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="https://achiev.com"

# 2. Supabase Database, Auth (Google / Apple / Microsoft / Email) & Realtime Sync
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"

# 3. User-Specific Personal Google Drive Storage Offloading (OAuth 2.0)
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# Optional Server-Side OAuth Code Flow Secrets (`/api/auth/google/*` — keep server-only)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="https://achiev.com/api/auth/google/callback"

# 4. Optional SMS OTP Gateway (Twilio or Fast2SMS — uses signed instant OTP when unset)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
FAST2SMS_API_KEY=""

